<header>
  <script>
    try {
      const defaultThemeMarker = "al-folio-dark-default-applied";
      if (!localStorage.getItem(defaultThemeMarker)) {
        localStorage.setItem(defaultThemeMarker, "true");
        if (typeof setThemeSetting === "function") {
          setThemeSetting("dark");
        } else {
          localStorage.setItem("theme", "dark");
          document.documentElement.setAttribute("data-theme-setting", "dark");
          document.documentElement.setAttribute("data-theme", "dark");
        }
      }
    } catch (error) {
      // Keep the system preference when browser storage is unavailable.
    }
  </script>

  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    role="navigation"
  >
    <div class="container">
      {% if site.enable_darkmode %}
        <ul class="navbar-nav navbar-menu-list flex-nowrap" style="margin-left: auto">
          <li class="toggle-container">
            <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
              <i class="fa-half-sun-moon" id="light-toggle-system"></i>
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
              <i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          </li>
        </ul>
      {% endif %}
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
